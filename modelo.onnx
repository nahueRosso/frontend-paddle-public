import torch

# modelo entrenado
model.eval()

# entrada de ejemplo
dummy_input = torch.randn(1, 3, 224, 224)  # según tu modelo

# exportar a ONNX
torch.onnx.export(
    model,
    dummy_input,
    "modelo.onnx",
    input_names=["input"],
    output_names=["output"],
    dynamic_axes={"input": {0: "batch_size"}, "output": {0: "batch_size"}}
)
