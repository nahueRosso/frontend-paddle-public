# Public frontend variables (available in browser bundle)
NEXT_PUBLIC_API_URL=https://api.midominio.com
NEXT_PUBLIC_DEMO_API_URL=https://api.midominio.com
NEXT_PUBLIC_TENANT_SCHEMA=public

# NextAuth / server-side private variables
NEXTAUTH_SECRET=replace_with_a_long_random_secret
AUTH_SECRET=replace_with_a_long_random_secret
NEXTAUTH_URL=https://tu-frontend.midominio.com

# OAuth providers (required only if social login is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: used in layout metadata if needed
FB_DOMAIN_VERIFICATION=
